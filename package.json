{
  "name": "livingston-schools",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && node dist/build.js",
    "typecheck": "tsc --noEmit",
    "new-year": "tsc && node dist/new-year.js",
    "fetch-school-events": "tsc && node dist/fetch-school-events.js",
    "refresh-school-events": "tsc && node dist/fetch-school-events.js --force && npm run build",
    "test": "tsc && node --test dist/school-events.test.js"
  },
  "dependencies": {
    "ics": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^11.0.0",
    "typescript": "^5.7.0"
  }
}
